# ===================================================
# Kredensial Wikipedia (untuk publikasi ke bak pasir)
# ===================================================
# Nama pengguna akun Wikipedia Anda (tanpa awalan Pengguna:)
WIKI_USERNAME=NamaAkunAnda

# Kata sandi bot dari Special:BotPasswords (kombinasi 32 karakter)
WIKI_BOT_PASSWORD=kombinasi_32_karakter_kata_sandi_bot

# Kredensial Wikidata (Opsional, untuk menghubungkan sitelink idwiki ke Wikidata item QID)
# Jika tidak disetel, akan fallback ke WIKI_BOT_USERNAME / WIKI_BOT_PASSWORD.
# Catatan: Jika bot password Anda dibuat hanya di id.wikipedia.org tanpa izin lintas-wiki / wikidata,
# buat Bot Password terpisah di https://www.wikidata.org/wiki/Special:BotPasswords
# dan isi di bawah ini:
# WIKIDATA_BOT_USERNAME=NamaAkunAnda@nama_bot_wikidata
# WIKIDATA_BOT_PASSWORD=kombinasi_32_karakter_bot_password_wikidata

# ===================================================
# Kredensial LLM Gemini (Opsional jika memakai Antigravity)
# ===================================================
# GEMINI_API_KEY=AIzaSy...
